# Один образ apps/giga используется как HTTP API (команда по умолчанию, порт 3102),
# `giga-worker`, `giga-assistant-worker`, `giga-calendar-agent` и `giga-catalog-agent`.
# Запускайте разные роли отдельными контейнерами, не объединяйте несколько циклов в один процесс.

# Общая PostgreSQL и S3. Без них HTTP health остаётся доступен, а воркеры простаивают.
DATABASE_URL=postgresql://portal:<пароль>@postgres:5432/portal
S3_ENDPOINT=https://s3.example.ru
S3_REGION=ru-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_GENERATIONS=generations
S3_BUCKET_DIAGNOSTICS=diagnostics

# --- Воркер генераций giga-worker ---

# Fail-closed: 1 ставьте только после миграций и проверки очереди в целевом окружении.
GIGA_LIFECYCLE_ENABLED=0
GIGA_POLL_INTERVAL_SECONDS=5
GIGA_MAX_ATTEMPTS=3
GIGA_LEASE_SECONDS=300
GIGA_HEARTBEAT_INTERVAL_SECONDS=60
GIGA_SHUTDOWN_GRACE_SECONDS=60

# --- Ассистент giga-assistant-worker ---

ASSISTANT_LIFECYCLE_ENABLED=0
ASSISTANT_POLL_INTERVAL_SECONDS=5
ASSISTANT_LEASE_SECONDS=90
ASSISTANT_EVIDENCE_LIMIT=6
ASSISTANT_MAX_RESPONSE_TOKENS=800
ASSISTANT_MAX_ATTEMPTS=3
ASSISTANT_HEARTBEAT_INTERVAL_SECONDS=20
ASSISTANT_SHUTDOWN_GRACE_SECONDS=30

# --- AI-провайдеры ---

# GigaChat нужен для диагностики, каталога и части текстовых операций.
# Пусто — соответствующие функции делают no-op или возвращают контролируемую ошибку.
GIGACHAT_CREDENTIALS=

# OpenAI-совместимые HyperPC endpoints: fast — быстрые ответы, structured — JSON-ответы.
HYPERPC_FAST_URL=
HYPERPC_STRUCTURED_URL=
HYPERPC_TIMEOUT_SECONDS=20
HYPERPC_MAX_RETRIES=2
HYPERPC_RETRY_BACKOFF_SECONDS=0.5

# OpenRouter используется для изображений и OpenSCAD-текста.
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=black-forest-labs/flux.2-klein-4b
OPENROUTER_TEXT_MODEL=google/gemma-4-31b-it:free
OPENROUTER_TEXT_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRIES=2
OPENROUTER_RETRY_BACKOFF_SECONDS=1.0

# ComfyUI нужен для TRELLIS/Z-Image/scan. Адрес должен быть доступен только серверному контуру.
COMFYUI_URL=
COMFYUI_TIMEOUT_SECONDS=20
COMFYUI_MAX_RETRIES=2
COMFYUI_RETRY_BACKOFF_SECONDS=0.5
COMFYUI_POLL_INTERVAL_SECONDS=3
COMFYUI_POLL_TIMEOUT_SECONDS=300
COMFYUI_OOM_MAX_RETRIES=1
COMFYUI_OOM_RETRY_BACKOFF_SECONDS=5.0
COMFYUI_EXPORT_TZ_OFFSET_HOURS=3
COMFYUI_TRELLIS_ESTIMATED_SECONDS=150

# Имена файлов весов Z-Image зависят от раскладки моделей на GPU-хосте.
# Без любого из трёх значений ветка concepts завершается контролируемой ошибкой.
ZIMAGE_UNET_NAME=
ZIMAGE_CLIP_NAME=
ZIMAGE_VAE_NAME=
ZIMAGE_STEPS=8
ZIMAGE_CFG=1
ZIMAGE_SAMPLER_NAME=res_multistep
ZIMAGE_SCHEDULER=simple
ZIMAGE_MODEL_SHIFT=3
ZIMAGE_WIDTH=1024
ZIMAGE_HEIGHT=1024
ZIMAGE_ESTIMATED_SECONDS=30

# Внешний сервис scan. Задайте адрес явно, чтобы не использовать исторический дефолт из кода.
SCAN_SERVICE_URL=

# Каталог textfile collector node_exporter. Пусто — метрики остаются только в логах.
PORTAL_QUEUE_METRICS_DIR=
